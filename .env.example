# Copy to .env; never commit real credentials.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://video:video_dev_password@localhost:5432/video_studio?schema=public
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=video-studio
S3_ACCESS_KEY_ID=videostudio
S3_SECRET_ACCESS_KEY=videostudio_dev_secret
S3_FORCE_PATH_STYLE=true

# Generate a unique 32-byte encryption key with:
# python3 -c 'import secrets; print(secrets.token_hex(32))'
AI_CONFIG_ENCRYPTION_KEY=
AI_ALLOWED_HOSTS=api.openai.com
AI_ALLOW_LOCAL_HTTP=false
